{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1260px"
    },
    "color": {
      "palette": [
        {
          "slug": "navy",
          "name": "Deep navy",
          "color": "#102A4F"
        },
        {
          "slug": "midnight",
          "name": "Midnight navy",
          "color": "#0B203D"
        },
        {
          "slug": "steel-blue",
          "name": "Steel blue",
          "color": "#90B1C2"
        },
        {
          "slug": "silver-grey",
          "name": "Silver grey",
          "color": "#CED3D9"
        },
        {
          "slug": "cool-white",
          "name": "Cool white",
          "color": "#F5F7F9"
        },
        {
          "slug": "copper",
          "name": "Copper",
          "color": "#B77B57"
        },
        {
          "slug": "copper-ink",
          "name": "Copper for readable text",
          "color": "#99603E"
        },
        {
          "slug": "slate",
          "name": "Slate text",
          "color": "#526577"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Inter — readable body",
          "slug": "inter",
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif"
        },
        {
          "name": "Montserrat — headings and actions",
          "slug": "montserrat",
          "fontFamily": "'Montserrat', 'Inter', Arial, sans-serif"
        },
        {
          "name": "Lora — editorial accent",
          "slug": "lora",
          "fontFamily": "'Lora', Georgia, serif"
        },
        {
          "name": "Space Mono — labels and detail",
          "slug": "space-mono",
          "fontFamily": "'Space Mono', Consolas, monospace"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#F5F7F9",
      "text": "#102A4F"
    },
    "elements": {
      "button": {
        "color": {
          "background": "#102A4F",
          "text": "#F5F7F9"
        }
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px"
    }
  }
}
